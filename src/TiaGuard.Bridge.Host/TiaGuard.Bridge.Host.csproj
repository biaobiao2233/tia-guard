<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tia-guard-bridge</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>
  <Target Name="BuildBridgeWorker" BeforeTargets="Build"
          Condition="'$(RuntimeIdentifier)' == ''">
    <MSBuild
      Projects="../TiaGuard.Bridge.Worker/TiaGuard.Bridge.Worker.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CopyBridgeWorker" AfterTargets="Build">
    <ItemGroup>
      <BridgeWorkerFiles Include="../TiaGuard.Bridge.Worker/bin/$(Configuration)/net48/TiaGuard.Bridge.Worker.exe" />
      <BridgeWorkerFiles Include="../TiaGuard.Bridge.Worker/bin/$(Configuration)/net48/TiaGuard.Bridge.Worker.exe.config"
                         Condition="Exists('../TiaGuard.Bridge.Worker/bin/$(Configuration)/net48/TiaGuard.Bridge.Worker.exe.config')" />
      <BridgeWorkerFiles Include="../TiaGuard.Bridge.Worker/bin/$(Configuration)/net48/TiaGuard.Openness.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeWorkerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
