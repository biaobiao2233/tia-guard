<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TiaGuard</AssemblyName>
    <RootNamespace>TiaGuard.Gui</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\TiaGuard.ico</ApplicationIcon>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\TiaGuard.ico" />
    <Resource Include="Assets\TiaGuard.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <ProjectReference Include="../TiaGuard.Openness/TiaGuard.Openness.csproj" />
  </ItemGroup>
</Project>
