<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants Condition="Exists('$(TwinCatInteropAssemblyPath)')">$(DefineConstants);TWINCAT_NATIVE_INTEROP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../contracts/TwinCat3.Contracts.csproj" />
    <Reference Include="TCatSysManagerLib" Condition="Exists('$(TwinCatInteropAssemblyPath)')">
      <HintPath>$(TwinCatInteropAssemblyPath)</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
</Project>
