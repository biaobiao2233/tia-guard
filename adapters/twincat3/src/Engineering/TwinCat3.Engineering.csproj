<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants Condition="Exists('$(TwinCatInteropAssemblyPath)') and Exists('$(TwinCatVsPublicAssemblies)/envdte80.dll')">$(DefineConstants);TWINCAT_NATIVE_INTEROP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../contracts/TwinCat3.Contracts.csproj" />
    <Reference Include="TCatSysManagerLib" Condition="Exists('$(TwinCatInteropAssemblyPath)')">
      <HintPath>$(TwinCatInteropAssemblyPath)</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="EnvDTE" Condition="Exists('$(TwinCatVsPublicAssemblies)/envdte.dll')"><HintPath>$(TwinCatVsPublicAssemblies)/envdte.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="EnvDTE80" Condition="Exists('$(TwinCatVsPublicAssemblies)/envdte80.dll')"><HintPath>$(TwinCatVsPublicAssemblies)/envdte80.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.VisualStudio.Interop" Condition="Exists('$(TwinCatVsPublicAssemblies)/Microsoft.VisualStudio.Interop.dll')"><HintPath>$(TwinCatVsPublicAssemblies)/Microsoft.VisualStudio.Interop.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
