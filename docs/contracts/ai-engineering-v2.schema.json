{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TIA-Guard derived AI engineering view v2 with bounded LAD graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "project",
    "hardware",
    "plc",
    "tagTables",
    "blocks",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ai-engineering-v2"
    },
    "authority": {
      "const": "derived-not-build-input"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "hardware": {
      "$ref": "#/$defs/hardware"
    },
    "plc": {
      "$ref": "#/$defs/plc"
    },
    "tagTables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tagTable"
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tiaVersion",
        "projectVersion",
        "sourceRef"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tiaVersion": {
          "const": "V21"
        },
        "projectVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station",
        "family",
        "cpuCreateIdentity",
        "orderNumber",
        "firmware",
        "sourceRef"
      ],
      "properties": {
        "station": {
          "type": "string"
        },
        "family": {
          "const": "S7-1200"
        },
        "cpuCreateIdentity": {
          "type": "string"
        },
        "orderNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "firmware": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        }
      }
    },
    "plc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourceRef"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        }
      }
    },
    "tagTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourceRef",
        "tags"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          }
        }
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dataType",
        "address",
        "commentStatus",
        "comment",
        "sourceRef"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "dataType": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "commentStatus": {
          "enum": [
            "present",
            "missing"
          ]
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "number",
        "language",
        "sourceRef",
        "xmlSourceRef",
        "networkInventory",
        "networks",
        "relationships"
      ],
      "properties": {
        "name": {
          "const": "Main"
        },
        "kind": {
          "const": "OB"
        },
        "number": {
          "const": 1
        },
        "language": {
          "const": "LAD"
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "xmlSourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "networkInventory": {
          "$ref": "#/$defs/coverage"
        },
        "networks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/network"
          }
        },
        "relationships": {
          "$ref": "#/$defs/relationships"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "language",
        "sourceRef",
        "titles",
        "comments",
        "logic",
        "id",
        "graph",
        "analysis"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "titles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "logic": {
          "$ref": "#/$defs/coverage"
        },
        "id": {
          "type": "string",
          "pattern": "^OB1/network-[1-9][0-9]*$"
        },
        "graph": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/graph"
            }
          ]
        },
        "analysis": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/analysis"
            }
          ]
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "culture",
        "text",
        "sourceRef"
      ],
      "properties": {
        "culture": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "area",
        "status",
        "reason"
      ],
      "properties": {
        "area": {
          "type": "string"
        },
        "status": {
          "enum": [
            "extracted",
            "empty",
            "not-extracted",
            "unsupported",
            "incomplete",
            "unknown",
            "supported",
            "partial",
            "ambiguous"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^(tia-guard\\.json|tia/[^#]+)#.*$"
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "nodes",
        "wires",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": "lad-evidence-v1"
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "wires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/wire"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "instruction",
        "scope",
        "symbol",
        "negated",
        "sourceUid",
        "sourceSelector"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "access",
            "instruction",
            "powerrail"
          ]
        },
        "instruction": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "negated": {
          "type": "boolean"
        },
        "sourceUid": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceSelector": {
          "type": "string"
        }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "endpoints",
        "sourceUid",
        "sourceSelector"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "endpoints": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "sourceUid": {
          "type": "string"
        },
        "sourceSelector": {
          "type": "string"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "nodeId",
        "port"
      ],
      "properties": {
        "kind": {
          "enum": [
            "Powerrail",
            "IdentCon",
            "NameCon"
          ]
        },
        "nodeId": {
          "type": "string"
        },
        "port": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "sourceRef"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        }
      }
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "accessId",
        "operandWireId",
        "symbol",
        "address",
        "negated"
      ],
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "accessId": {
          "type": "string"
        },
        "operandWireId": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "negated": {
          "type": "boolean"
        }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "expression",
        "path"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/use"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "path": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "fromPort",
        "to",
        "toPort",
        "wireId"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "fromPort": {
          "enum": [
            "power",
            "out"
          ]
        },
        "to": {
          "type": "string"
        },
        "toPort": {
          "const": "in"
        },
        "wireId": {
          "type": "string"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evaluation",
        "reads",
        "writes",
        "flows",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "unknown",
            "ambiguous",
            "unavailable"
          ]
        },
        "evaluation": {
          "type": "string"
        },
        "reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/use"
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/write"
          }
        },
        "flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flow"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported"
              }
            }
          },
          "then": {
            "properties": {
              "diagnostics": {
                "maxItems": 0
              },
              "writes": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "reads": {
                "maxItems": 0
              },
              "writes": {
                "maxItems": 0
              },
              "flows": {
                "maxItems": 0
              },
              "diagnostics": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "symbol",
            "args"
          ],
          "properties": {
            "op": {
              "const": "read"
            },
            "symbol": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "symbol",
            "args"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "symbol": {
              "type": "null"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "symbol",
            "args"
          ],
          "properties": {
            "op": {
              "const": "and"
            },
            "symbol": {
              "type": "null"
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      ]
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "interlocks",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "unavailable"
          ]
        },
        "interlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interlock"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "interlocks": {
                "maxItems": 0
              },
              "diagnostics": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "interlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "members",
        "evidence",
        "meaning"
      ],
      "properties": {
        "kind": {
          "const": "mutual-output-inhibit"
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/interlockEvidence"
          }
        },
        "meaning": {
          "type": "string"
        }
      }
    },
    "interlockEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkId",
        "writeNodeId",
        "readNodeId",
        "sourceRef"
      ],
      "properties": {
        "networkId": {
          "type": "string"
        },
        "writeNodeId": {
          "type": "string"
        },
        "readNodeId": {
          "type": "string"
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        }
      }
    }
  }
}
