{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tia-guard/finding-v1.schema.json",
  "title": "TIA-Guard Finding v1 (draft)",
  "type": "object",
  "required": ["schemaVersion", "ruleId", "severity", "message", "applicability", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "ruleId": {
      "type": "string",
      "pattern": "^TIA\\.[A-Z0-9_.-]+$"
    },
    "severity": { "enum": ["info", "warning", "error"] },
    "message": { "type": "string", "minLength": 1 },
    "applicability": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["applicable", "not-applicable", "partial"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "objectRef": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "enum": ["snapshot-object", "artifact", "diagnostic", "compile"] },
          "ref": { "type": "string", "minLength": 1 },
          "detail": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "location": {
      "type": ["object", "null"],
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "required": ["artifact"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
