<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <TiaPortalPublicApi Condition="'$(TiaPortalPublicApi)' == ''">$(ProgramFiles)\Siemens\Automation\Portal V21\PublicAPI\V21\net48</TiaPortalPublicApi>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GenerationSpecRoot)' != ''">
    <DefineConstants>$(DefineConstants);PROJECT_GENERATION_SPEC_V1</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GenerationCompilationRoot)' != ''">
    <DefineConstants>$(DefineConstants);PROJECT_GENERATION_COMPILATION_V1</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Siemens.Engineering.Base"><HintPath>$(TiaPortalPublicApi)\Siemens.Engineering.Base.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Siemens.Engineering.Step7"><HintPath>$(TiaPortalPublicApi)\Siemens.Engineering.Step7.dll</HintPath><Private>false</Private></Reference>
    <!-- Compile the exact combination without editing shared project files or copying providers. -->
    <Compile Include="../../src/TiaGuard.Openness/*.cs" Link="Engine/%(Filename)%(Extension)" />
    <Compile Include="$(GenerationSpecRoot)/src/TiaGuard.Openness/ProjectGenerationSpec*.cs" Link="Contract/%(Filename)%(Extension)" Condition="'$(GenerationSpecRoot)' != ''" />
    <Compile Include="$(GenerationCompilationRoot)/src/TiaGuard.Openness/Compilation*.cs" Link="Compilation/%(Filename)%(Extension)" Condition="'$(GenerationCompilationRoot)' != ''" />
  </ItemGroup>
</Project>
